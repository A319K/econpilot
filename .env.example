LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.2
LLM_API_KEY=

DATABASE_URL=sqlite:///./econpilot.db

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFIER=none|telegram|hermes
# HERMES_SEND_TARGET=telegram
# HERMES_BIN=hermes

# WATCHER_ENABLED=true
# WATCH_INTERVAL_MINUTES=30
# WATCH_NOTIFY_MIN_SCORE=40
# WATCH_QUIET_HOURS=23-07

# Seasonal pre-activation (Phase B): on the 1st of each month, refresh the
# company corpus from the listings feed and flip companies that historically
# post next month into active watch targets. Runs only when the watcher is on.
# SEASONAL_PREACTIVATION_ENABLED=true

# Discovery source: SimplifyJobs internship-list repo. The structured
# listings.json (absolute dates, ATS urls) is read, not the README. Changes
# each season, so it's configurable.
# GITHUB_REPO_OWNER=SimplifyJobs
# GITHUB_REPO_NAME=Summer2026-Internships
# GITHUB_REPO_BRANCH=dev
# GITHUB_REPO_LISTINGS_PATH=.github/scripts/listings.json

# Additional listings feeds merged in for redundancy + broader (startup)
# coverage. JSON array of "owner/name/branch/path", same listings.json schema.
# A failing feed is skipped, never breaking the others. Add
# SimplifyJobs/New-Grad-Positions/... here to also track full-time roles.
# GITHUB_ADDITIONAL_FEEDS=["vanshb03/Summer2026-Internships/dev/.github/scripts/listings.json"]

# Optional official federal Economist (occupational series 0110) listings.
# Request a free API key using the same email supplied as USER_AGENT. Leave both
# blank to keep USAJOBS disabled; every other discovery source still works.
# USAJOBS_API_KEY=
# USAJOBS_USER_AGENT=your-email@example.com

# Discovery: drop jobs whose posting date is older than this many days at scan
# time (internship boards accumulate stale roles). 0 disables; undated jobs are
# always kept. Default 21 (~3 weeks).
# SCAN_MAX_AGE_DAYS=21

# Discovery: keep the queue focused on economics-oriented roles. Big ATS tenants
# list every function, so unclassified full-time and internship roles are
# dropped by default. Set false to ingest everything for manual review.
# DISCOVERY_ECON_ONLY=true

# Materials: whether Prepare rewrites a job-specific resume. Default false =
# select the best-fit pre-built base resume and reuse its compiled PDF (no
# per-job LLM rewrite). Set true to tailor summary/skills on every Prepare.
# PREPARE_TAILOR_DEFAULT=false
